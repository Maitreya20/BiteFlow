# Copy `.env.example` to `.env.local` and fill in the real credentials from
# Supabase → Project Settings → API. `.env.local` is gitignored and is where
# your real keys live. `.env` is safe to commit and ships as placeholders.
#
#   cp .env.example .env.local
#   # then paste the real values into .env.local
{VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_PUBLIC_SITE_URL=https://your-public-domain.example

# Leave unset (or "false") to run against your real Supabase project.
VITE_DEMO_MODE=false
